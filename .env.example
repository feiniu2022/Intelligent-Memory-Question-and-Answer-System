# ========== LLM 配置 ==========
CHAT_MODEL=deepseek-v4-pro
CHAT_BASE_URL=https://opencode.ai/zen/go/v1
CHAT_API_KEY=sk-your-api-key-here

# ========== Embedding 配置 ==========
EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_BASE_URL=http://localhost:11434

# ========== 存储路径 ==========
MEMORY_DB_DIR=data/memory_db
KNOWLEDGE_DB_DIR=data/knowledge_db
TXT_DATA_DIR=data/txt_files
UPLOAD_DIR=uploads

# ========== 检索配置 ==========
HYBRID_SEARCH_K=5
HYBRID_SEARCH_ALPHA=0.5

# ========== RAG 配置 ==========
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_HYDE_ENABLED=true

# ========== Agent 配置 ==========
MAX_MESSAGES=30
SUMMARY_THRESHOLD=20

# ========== JWT 配置 ==========
JWT_SECRET=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ========== 数据库 ==========
DB_PATH=data/app.db

# ========== 服务 ==========
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000